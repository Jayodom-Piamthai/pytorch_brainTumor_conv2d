{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend/tumor-scanner-app && npm run build",
  "outputDirectory": "frontend/tumor-scanner-app/dist",
  "functions": {
    "backend/main.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backEnd/webAPI.py" }
  ]
}